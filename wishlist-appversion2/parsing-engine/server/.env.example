# 이 파일을 .env로 복사해서 실제 값을 채운 뒤 사용하세요. .env는 절대 커밋하지 마세요.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# 아래는 전부 선택값 — 안 채우면 config.py의 기본값을 쓴다.
# EXTRACT_TIMEOUT_S=45
# RENDER_NAV_TIMEOUT_MS=20000
# GEMINI_MAX_RETRIES=4
# GEMINI_MAX_CONCURRENCY=6  # 2026-09-29 Tier 1(유료) 전환 후 기본값. 무료 티어면 3 권장
# RENDER_MAX_CONCURRENCY=6
# RSS_SAMPLE_INTERVAL_MS=100
# 호스트/포트는 uvicorn 실행 인자(--host, --port)로 정한다 — Dockerfile CMD 참고.

# 태그 사진으로 찾기(POST /identify-tag) — 선택값
# GEMINI_TAG_MODEL=          # 비우면 GEMINI_MODEL
# GEMINI_SEARCH_MODEL=       # 비우면 GEMINI_MODEL. Google 검색 그라운딩을 지원하는 모델이어야 함
# IDENTIFY_TIMEOUT_S=25      # AppSync 30초 한도 때문에 늘리지 말 것(config.py 주석 참고)
# IDENTIFY_MAX_CANDIDATES=3
